# Public read-only Supabase access (required to display events)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional preferred name: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Server only. Never use the compromised legacy service-role JWT.
SUPABASE_SECRET_KEY=your-new-supabase-secret-key
# Authentication for cron and HMAC salt for abuse limits. Never expose publicly.
CRON_SECRET=your-random-secret-string
APIFY_API_TOKEN=your-apify-token
APIFY_ACTOR=apify~instagram-scraper
# Defaults to 3; hard cap 5 posts per account. Fixed 3-day window; only 7 allowlisted accounts.
APIFY_RESULTS_LIMIT=3
# APIFY_NEWER_THAN is intentionally ignored: the production window is fixed at 3 days.
